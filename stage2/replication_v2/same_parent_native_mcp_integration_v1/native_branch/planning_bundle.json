    },
    "witness:2": {
      "end": 405,
      "quote": "\"\"\"Old v1 HTTP path, retained temporarily across the upgrade.\"\"\"\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\n\nclass LegacyHandler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        self.send_response(410)\n        self.end_headers()\n        self.wfile.write(b\"Legacy checkout retired\")\n\n\ndef main():\n    ThreadingHTTPServer((\"127.0.0.1\", 8080), LegacyHandler).serve_forever()\n",
      "read_id": "read:2",
      "ref": "file:legacy_compat.py",
      "scope": "EXACT_READ_SOURCE_SPAN_NOT_SEMANTIC_VERDICT",
      "source_locator": {
        "archive_sha256": "68071e87a2153fe9afa31519aaf6f4d67cfebaa478d35036773901e8176bddc6",
        "json_pointer": "",
