    "witness:1": {
      "end": 319,
      "quote": "\"\"\"Service launcher from the previous release.\"\"\"\nimport os\nfrom checkout_app.server import main as current_main\nfrom legacy_compat import main as legacy_main\n\n\ndef main():\n    if os.getenv(\"CHECKOUT_COMPAT\", \"on\") == \"on\":\n        legacy_main()\n    else:\n        current_main()\n\n\nif __name__ == \"__main__\":\n    main()\n",
      "read_id": "read:1",
      "ref": "file:run.py",
      "scope": "EXACT_READ_SOURCE_SPAN_NOT_SEMANTIC_VERDICT",
      "source_locator": {
        "archive_sha256": "68071e87a2153fe9afa31519aaf6f4d67cfebaa478d35036773901e8176bddc6",
