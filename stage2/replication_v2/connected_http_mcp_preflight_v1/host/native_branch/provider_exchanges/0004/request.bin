_main()\\\\n\\\\n\\\\nif __name__ == \\\\\\\"__main__\\\\\\\":\\\\n    main()\\\\n\\\"\"}}], \"available_roles\": [{\"id\": \"release_lead\", \"role\": \"Release Lead\"}, {\"id\": \"backend\", \"role\": \"Backend Engineer\"}, {\"id\": \"frontend\", \"role\": \"Frontend Engineer\"}, {\"id\": \"sre\", \"role\": \"Site Reliability Engineer\"}, {\"id\": \"security\", \"role\": \"Security Engineer\"}, {\"id\": \"data\", \"role\": \"Telemetry Analyst\"}, {\"id\": \"product\", \"role\": \"Product Operations Specialist\"}, {\"id\": \"reviewer\", \"role\": \"Release Reviewer\"}], \"available_actions\": {\"list_files\": {}, \"read_file\": {\"path\": \"relative path\"}, \"write_file\": {\"path\": \"relative path\", \"content\": \"entire UTF-8 file\"}, \"run_tests\": {}, \"message\": {\"to\": \"role id\", \"content\": \"message\"}, \"delegate\": {\"to\": \"role id\", \"content\": \"request\"}, \"finalize\": {\"answer\": \"user-facing result\"}}, \"remaining_turns\": 57, \"required_action_envelope\": {\"top_level\": {\"actions\": \"list[action_object]\"}, \"action_object\": {\"type\": \"exactly one key from available_actions\", \"arguments\": \"fields declared for that available_actions entry, at the same object level\"}, \"forbidden_shape_examples\": [{\"action\": \"ACTION_NAME\"}, {\"actions\": [{\"ACTION_NAME\": {}}]}]}, \"max_actions_per_turn\": 5, \"action_contract_id\": \"v2_t2_t3_prospective\"}"}], "max_tokens": 4096, "temperature": 0.7, "thinking": {"type": "disabled"}, "response_format": {"type": "json_object"}}