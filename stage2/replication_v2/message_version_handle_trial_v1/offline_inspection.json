        "read_id": "read:3",
        "ref": "file:web/app.js",
        "text": "fetch(\"/api/status\")\n  .then(response => response.json())\n  .then(status => { document.querySelector(\"#status\").textContent = `Checkout ${status.version}`; });\n",
        "source_locator": {
          "archive_sha256": "68071e87a2153fe9afa31519aaf6f4d67cfebaa478d35036773901e8176bddc6",
          "member": "checkpoints/0dd1950f9747ac83f832c3d7505c7d4ff074ee086a294bd524eba0521efd8007/application/web/app.js",
          "member_sha256": "ea71ea811176430b89c4075881c3381cac04be21b3aeeb105d7ce12e5821f8c3",
          "json_pointer": "",
          "line": null
