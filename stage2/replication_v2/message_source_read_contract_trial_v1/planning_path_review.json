  "reads": {
    "read:1": {
      "read_id": "read:1",
      "ref": "state:host_parent",
      "text": "The checkout page already has a working payment button: the `<button type=\"submit\" id=\"pay-button\">Pay now</button>` inside `#checkout-form`, wired in `/app.js` to POST the cart and selected method to `/api/checkout`, disable itself while processing, and show the success or failure result in `#result`. No changes were needed, so I left the files untouched to avoid breaking the existing flow.",
      "source_locator": {
        "archive_sha256": "68071e87a2153fe9afa31519aaf6f4d67cfebaa478d35036773901e8176bddc6",
        "member": "checkpoints/97b33360ed243c8c4ebda10598b708e1f69c1e375ba2a7a1001c0bba3d65fec5/native_state.json",
        "member_sha256": "cbe22e91bf8716fd392009195422685d4ccc3e6177cf5b1880ae320f71dde32b",
