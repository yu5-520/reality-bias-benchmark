    "witness:6": {
      "end": 535,
      "quote": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Checkout</title></head>\n<body><main><h1>Checkout</h1><p id=\"status\">Loading checkout status</p>\n<form id=\"checkout-form\">\n  <label for=\"method\">Payment method</label>\n  <select id=\"method\" name=\"method\">\n    <option value=\"card\">Card</option>\n    <option value=\"bank_transfer\">Bank transfer</option>\n  </select>\n  <button type=\"submit\" id=\"pay-button\">Pay now</button>\n</form>\n<p id=\"result\" aria-live=\"polite\"></p></main><script src=\"/app.js\"></script></body></html>\n",
      "read_id": "read:7",
