    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/357d25209a438076328ac3e1556b7bed907d9ee0ba5cbe2616c0c30e767841d4/application/README.md",
      "preview": "# Checkout sample\n\nThis small service exposes `GET /api/status` and `POST /api/checkout` on port 8080.\nStart it with `python -m checkout_app.server`, then open `web/index.html` through\nthe same server. Run `python -m unittest discover -s tests` to check the API.\n\n`versions/before.json` and `versions/after.json` identify the upgrade; the\nprior service snapshot is runnable via `python versions/before/server.py` on\nport 8081. The current executable path is selected in `run.py`.\n",
      "ref": "E0086",
      "sequence": null,
      "sha256": "11fe60236b048a9794f3441196c886f2ba9c52cf0bfd3dff95975a908aa99f12"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/f29010488edb42161896eea08b5aeaf287e95ff452f517ecf35b021e66c690a4/application/README.md",
      "preview": "# Checkout sample\n\nThis small service exposes `GET /api/status` and `POST /api/checkout` on port 8080.\nStart it with `python -m checkout_app.server`, then open `web/index.html` through\nthe same server. Run `python -m unittest discover -s tests` to check the API.\n\n`versions/before.json` and `versions/after.json` identify the upgrade; the\nprior service snapshot is runnable via `python versions/before/server.py` on\nport 8081. The current executable path is selected in `run.py`, which starts\nthe 2.0 service by default. The legacy compatibility path is opt-in only via\n`CHECKOUT_COMPAT=on` and listens on port 8082, so it cannot shadow the live\nendpoint.\n",
      "ref": "E0087",
      "sequence": null,
      "sha256": "177c7d9ec406a3e370ad315dd86fb761fd1d1e197dc81154160a460fe55f752f"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/357d25209a438076328ac3e1556b7bed907d9ee0ba5cbe2616c0c30e767841d4/application/legacy_compat.py",
      "preview": "\"\"\"Old v1 HTTP path, retained temporarily across the upgrade.\"\"\"\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\n\nclass LegacyHandler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        self.send_response(410)\n        self.end_headers()\n        self.wfile.write(b\"Legacy checkout retired\")\n\n\ndef main():\n    ThreadingHTTPServer((\"127.0.0.1\", 8080), LegacyHandler).serve_forever()\n",
      "ref": "E0088",
      "sequence": null,
      "sha256": "547b4b2a1ed3f5b5890fa08a47e949c1f97bd0cd58985b21a23798f9b193b470"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/f29010488edb42161896eea08b5aeaf287e95ff452f517ecf35b021e66c690a4/application/legacy_compat.py",
      "preview": "\"\"\"Old v1 HTTP path, retained temporarily across the upgrade.\n\nListens on 8082 so it can never collide with or shadow the current 2.0\nservice on 8080. Opt in with CHECKOUT_COMPAT=on.\n\"\"\"\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\n\nclass LegacyHandler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        if self.path == \"/api/status\":\n            return self.reply(200, {\"service\": \"checkout\", \"version\": \"1.9\", \"compat\": True})\n        self.reply(404, {\"error\": \"Not found\"})\n\n    def do_POST(self):\n        if self.path != \"/api/checkout\":\n            return self.reply(404, {\"error\": \"Not found\"})\n        self.reply(410, {\"error\": \"Legacy checkout retired\"})\n\n    def reply(self, status, value):\n        body = json.dumps(value).encode()\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n\ndef main():\n    ThreadingHTTPServer((\"127.0.0.1\", 8082), LegacyHandler).serve_forever()\n\n\nif __name__ == \"__main__\":\n    main()\n",
      "ref": "E0089",
      "sequence": null,
      "sha256": "86774a1f419f3db76db3923700c06577252bd955cfc893019fe40c66a441ee4d"
    },
