    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/a18d01d185b1ed6e009a1b196dd24f27f9c59f9fa6002cb384e1dfc050efc4b2/application/legacy_compat.py",
      "preview": "\"\"\"Removed in the v2.0 upgrade. Kept only as a hard-fail stub.\n\nThe legacy v1 HTTP path (port 8080, returns 410) is retired. Any attempt to\nimport this module fails immediately so the old compatibility path can never\ninterfere with checkout. Use checkout_app.server instead.\n\"\"\"\n\nraise ImportError(\n    \"legacy_compat was removed in the v2.0 upgrade; use checkout_app.server instead\"\n)\n",
      "ref": "E0087",
      "sequence": null,
      "sha256": "f980efd94c6b5e496f89a10b453a5b93f163745fecde9eec3ef998f907237157"
