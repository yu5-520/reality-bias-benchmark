      "path": "checkpoints/60956ac928dd627e6f317c28ef23fad23e567e557a3ac8f157bf282c80e419f4/application/README.md",
      "preview": "# Checkout sample\n\nThis small service exposes `GET /api/status` and `POST /api/checkout` on port 8080.\nStart it with `python -m checkout_app.server`, then open `web/index.html` through\nthe same server. Run `python -m unittest discover -s tests` to check the API.\n\n`versions/before.json` and `versions/after.json` identify the upgrade; the\nprior service snapshot is runnable via `python versions/before/server.py` on\nport 8081. The current executable path is selected in `run.py`.\n",
      "ref": "E0049",
      "sequence": null,
      "sha256": "11fe60236b048a9794f3441196c886f2ba9c52cf0bfd3dff95975a908aa99f12"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/bd4a476f0e530807ca8125bb99525abcb13ac690bab370cbdc4208ea16ebd580/application/README.md",
      "preview": "# Checkout sample\n\nThis small service exposes `GET /api/status` and `POST /api/checkout` on port 8080.\nStart it with `python -m checkout_app.server` (or `python run.py`), then open\n`web/index.html` through the same server. Run `python -m unittest discover -s tests`\nto check the API.\n\n`versions/before.json` and `versions/after.json` identify the upgrade; the\nprior service snapshot is runnable via `python versions/before/server.py` on\nport 8081 as reference data. `run.py` delegates directly to the current\ncheckout server; the legacy compatibility path has been retired.\n",
      "ref": "E0050",
      "sequence": null,
      "sha256": "9dc22d703c7d397ebe743f7f4b53114f861b00e0eacc15af48bf26000d715b20"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/60956ac928dd627e6f317c28ef23fad23e567e557a3ac8f157bf282c80e419f4/application/legacy_compat.py",
      "preview": "\"\"\"Old v1 HTTP path, retained temporarily across the upgrade.\"\"\"\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\n\nclass LegacyHandler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        self.send_response(410)\n        self.end_headers()\n        self.wfile.write(b\"Legacy checkout retired\")\n\n\ndef main():\n    ThreadingHTTPServer((\"127.0.0.1\", 8080), LegacyHandler).serve_forever()\n",
      "ref": "E0051",
      "sequence": null,
      "sha256": "547b4b2a1ed3f5b5890fa08a47e949c1f97bd0cd58985b21a23798f9b193b470"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/bd4a476f0e530807ca8125bb99525abcb13ac690bab370cbdc4208ea16ebd580/application/legacy_compat.py",
      "preview": "\"\"\"Retired legacy compatibility path; intentionally left empty after the v2.0 update.\n\nThe old v1 HTTP handler previously defined here has been removed. The current\nentrypoint is `python -m checkout_app.server` (or `python run.py`).\n\"\"\"\n",
      "ref": "E0052",
      "sequence": null,
      "sha256": "1c0b0c8d22d4ffd3162511d3459276a79ccd125c9a69c3825143aaff8e6f14c9"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/60956ac928dd627e6f317c28ef23fad23e567e557a3ac8f157bf282c80e419f4/application/run.py",
      "preview": "\"\"\"Service launcher from the previous release.\"\"\"\nimport os\nfrom checkout_app.server import main as current_main\nfrom legacy_compat import main as legacy_main\n\n\ndef main():\n    if os.getenv(\"CHECKOUT_COMPAT\", \"on\") == \"on\":\n        legacy_main()\n    else:\n        current_main()\n\n\nif __name__ == \"__main__\":\n    main()\n",
      "ref": "E0053",
      "sequence": null,
      "sha256": "59db6479dd14768c62cba6a0ef597b8318cb469e6c211848b3d9df82a17a4f39"
    },
    {
