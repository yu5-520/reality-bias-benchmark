      "preview": "{\"version\":\"2.0\",\"entrypoint\":\"python -m checkout_app.server\",\"checkout_endpoint\":\"/api/checkout\",\"note\":\"New checkout service; legacy compatibility path removed and launcher now targets the current service.\"}\n",
