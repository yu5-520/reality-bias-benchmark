    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/25967fc4b3ea752cc788db1bd2695f9231672f41b1c9dc243a543c1f5d13b24b/application/README.md",
      "preview": "# Checkout sample\n\nThis small service exposes `GET /api/status` and `POST /api/checkout` on port 8080.\nStart it with `python -m checkout_app.server` (or `python run.py`), then open\n`web/index.html` through the same server. Run `python -m unittest discover -s tests`\nto check the API.\n\n`versions/before.json` and `versions/after.json` identify the upgrade; the\nprior service snapshot is runnable via `python versions/before/server.py` on\nport 8081. The current service is launched from `run.py`.\n",
      "ref": "E0079",
      "sequence": null,
      "sha256": "045dec29c459d48bb0bcd5487b0c014bac3fe3106422482ffd1f111036672259"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/d893bd6d9a6d257aae0c2833847cb61a15eb2aacbf179d0783d13244769d149c/application/README.md",
      "preview": "# Checkout sample\n\nThis small service exposes `GET /api/status` and `POST /api/checkout` on port 8080.\nStart it with `python -m checkout_app.server`, then open `web/index.html` through\nthe same server. Run `python -m unittest discover -s tests` to check the API.\n\n`versions/before.json` and `versions/after.json` identify the upgrade; the\nprior service snapshot is runnable via `python versions/before/server.py` on\nport 8081. The current executable path is selected in `run.py`.\n",
      "ref": "E0080",
      "sequence": null,
      "sha256": "11fe60236b048a9794f3441196c886f2ba9c52cf0bfd3dff95975a908aa99f12"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/25967fc4b3ea752cc788db1bd2695f9231672f41b1c9dc243a543c1f5d13b24b/application/legacy_compat.py",
      "preview": "\"\"\"Removed: the v1 compatibility HTTP path was retired with the 2.0 upgrade.\n\nThis module is intentionally empty. The current service is launched via\n`python -m checkout_app.server` (or `python run.py`).\n\"\"\"\n",
      "ref": "E0081",
      "sequence": null,
      "sha256": "912a3bd5cc504acff6a8ebf1c9f1c71b0dce8c7e447d437c8cbd246dff1c7442"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/d893bd6d9a6d257aae0c2833847cb61a15eb2aacbf179d0783d13244769d149c/application/legacy_compat.py",
      "preview": "\"\"\"Old v1 HTTP path, retained temporarily across the upgrade.\"\"\"\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\n\nclass LegacyHandler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        self.send_response(410)\n        self.end_headers()\n        self.wfile.write(b\"Legacy checkout retired\")\n\n\ndef main():\n    ThreadingHTTPServer((\"127.0.0.1\", 8080), LegacyHandler).serve_forever()\n",
      "ref": "E0082",
      "sequence": null,
      "sha256": "547b4b2a1ed3f5b5890fa08a47e949c1f97bd0cd58985b21a23798f9b193b470"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/25967fc4b3ea752cc788db1bd2695f9231672f41b1c9dc243a543c1f5d13b24b/application/run.py",
      "preview": "\"\"\"Service launcher for the current release.\"\"\"\nfrom checkout_app.server import main\n\n\nif __name__ == \"__main__\":\n    main()\n",
      "ref": "E0083",
      "sequence": null,
      "sha256": "4f4655b840247b445da00e6563c8f7cf6e1401fd0ea02afc48b913a1ea045896"
    },
    {
      "kind": "PERSISTED_FILE_SNAPSHOT",
      "path": "checkpoints/d893bd6d9a6d257aae0c2833847cb61a15eb2aacbf179d0783d13244769d149c/application/run.py",
      "preview": "\"\"\"Service launcher from the previous release.\"\"\"\nimport os\nfrom checkout_app.server import main as current_main\nfrom legacy_compat import main as legacy_main\n\n\ndef main():\n    if os.getenv(\"CHECKOUT_COMPAT\", \"on\") == \"on\":\n        legacy_main()\n    else:\n        current_main()\n\n\nif __name__ == \"__main__\":\n    main()\n",
      "ref": "E0084",
      "sequence": null,
      "sha256": "59db6479dd14768c62cba6a0ef597b8318cb469e6c211848b3d9df82a17a4f39"
