{
  "version": "RB-EXPERIMENTAL-CONTROL-v0.1",
  "mode": "observe_only_by_default",
  "baseline_mutation": false,
  "intervention_requires_explicit_protocol": true,
  "branching": {
    "original_trajectory_immutable": true,
    "parent_state_hash_required": true,
    "parent_trace_hash_required": true,
    "intervention_hash_required": true,
    "replicate_index_required": true,
    "provider_internal_state_replay_claim_allowed": false
  },
  "commit_gate": {
    "enabled_by_default": false,
    "default_decision": "BLOCK",
    "allowed_action_types": [
      "write_state",
      "invoke_agent",
      "revise_final_state"
    ],
    "allowed_authority_classes": [
      "I",
      "V",
      "T"
    ],
    "require_source_refs": false,
    "require_expected_state_hash": true
  },
  "supported_state_interventions": [
    "set_shared_state",
    "remove_shared_state_key",
    "set_shared_state_status",
    "set_terminated"
  ],
  "scientific_boundary": "This layer is an experimental instrument for freeze/replay/branch/intervention. It is not part of the subject model prompt, does not expose Reality Bias labels to subject Agents, and does not claim replay of provider-internal randomness."
}
