{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-STRUCTURAL-SUPPORT-SCOUT-v0.1",
  "title": "Process Reality v5 Structural Support Scout v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "source_event_schema",
    "rules",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "RB-STRUCTURAL-SUPPORT-SCOUT-v0.1"
    },
    "version": {
      "const": "0.1"
    },
    "date": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "source_event_schema": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "rule_id",
          "candidate_type",
          "description"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_type": {
            "enum": [
              "STRUCTURAL_SUPPORT_CANDIDATE",
              "STABLE_SHARED_POOL_ENTRY_CANDIDATE",
              "DIRECT_POOL_CONSUMPTION_CANDIDATE",
              "STRUCTURAL_EXPOSURE_CANDIDATE"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
