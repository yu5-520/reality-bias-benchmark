{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/bounded_semantic_review_packet_v0.1.schema.json",
  "title": "Reality Bias Bounded Semantic Review Packet v0.1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "packet_id",
    "trajectory_id",
    "source_trace_hash",
    "review_contract_binding",
    "jump_candidate",
    "root_behavior_event",
    "source_context",
    "lineage_window",
    "operational_window",
    "retrospective_window",
    "adjudication_questions",
    "boundary_fields",
    "context_expansion",
    "packet_hash"
  ],
  "properties": {
    "schema": {"const": "RB-BOUNDED-SEMANTIC-REVIEW-PACKET-v0.1"},
    "version": {"const": "0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "source_trace_hash": {"type": "string", "minLength": 1},
    "review_contract_binding": {
      "type": "object",
      "required": ["schema", "version", "hash"],
      "properties": {
        "schema": {"const": "RB-SEMANTIC-AUTHORITY-REVIEW-CONTRACT-v0.1"},
        "version": {"const": "0.1"},
        "hash": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "jump_candidate": {"type": "object"},
    "root_behavior_event": {"type": "object"},
    "source_context": {"type": "object"},
    "lineage_window": {"type": "object"},
    "operational_window": {"type": "object"},
    "retrospective_window": {"type": "object"},
    "adjudication_questions": {"type": "object"},
    "boundary_fields": {"type": "object"},
    "context_expansion": {"type": "object"},
    "packet_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}