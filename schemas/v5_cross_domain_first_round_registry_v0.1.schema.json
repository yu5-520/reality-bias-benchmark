{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"RB-V5-CROSS-DOMAIN-FIRST-ROUND-REGISTRY-v0.1",
  "title":"Cross-Domain First-Round Evidence Registry v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","first_round_id","wave_count","all_waves_present","same_execution_sha",
    "same_plan_hash","planned_selected_run_count","preserved_trace_count","runner_error_count",
    "domain_trace_counts","wave_batches","code_commit_sha","plan_hash","semantic_status","registry_hash"
  ],
  "properties":{
    "schema":{"const":"RB-V5-CROSS-DOMAIN-FIRST-ROUND-REGISTRY-v0.1"},
    "first_round_id":{"type":"string"},
    "wave_count":{"const":6},
    "all_waves_present":{"const":true},
    "same_execution_sha":{"const":true},
    "same_plan_hash":{"const":true},
    "planned_selected_run_count":{"const":120},
    "preserved_trace_count":{"type":"integer","minimum":0},
    "runner_error_count":{"type":"integer","minimum":0},
    "domain_trace_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "wave_batches":{"type":"array","minItems":6,"maxItems":6},
    "code_commit_sha":{"type":"string"},
    "plan_hash":{"type":"string"},
    "semantic_status":{"const":"NOT_ADJUDICATED"},
    "registry_hash":{"type":"string"}
  }
}
