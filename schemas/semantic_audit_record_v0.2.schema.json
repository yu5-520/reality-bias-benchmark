{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-SEMANTIC-AUDIT-RECORD-v0.2",
  "title": "Reality Bias Semantic Audit Record v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audit_id",
    "auditor",
    "scope",
    "evidence_binding",
    "source_proposition",
    "semantic_role",
    "relation_type",
    "structural_facts_used",
    "interpretation",
    "claim_status",
    "causal_design_support",
    "boundary"
  ],
  "properties": {
    "schema": {
      "const": "RB-SEMANTIC-AUDIT-RECORD-v0.2"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditor_kind",
        "auditor_id",
        "blind_to_prior_semantic_labels"
      ],
      "properties": {
        "auditor_kind": {
          "enum": [
            "MODEL",
            "HUMAN",
            "HYBRID"
          ]
        },
        "auditor_id": {
          "type": "string",
          "minLength": 1
        },
        "blind_to_prior_semantic_labels": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_stage",
        "trace_id"
      ],
      "properties": {
        "experiment_stage": {
          "enum": [
            "R2",
            "R3",
            "R4",
            "R5",
            "R6",
            "R7",
            "R2-R4",
            "R5-R6",
            "R2-R7"
          ]
        },
        "condition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "replicate_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_evidence_ref",
        "evidence_pointers"
      ],
      "properties": {
        "raw_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "raw_evidence_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "structural_bundle_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "structural_bundle_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_pointers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "minLength": 1
              },
              "minimal_excerpt_or_field": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "source_proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_or_field",
        "epistemic_status"
      ],
      "properties": {
        "text_or_field": {
          "type": "string",
          "minLength": 1
        },
        "epistemic_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "downstream_proposition_or_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "text_or_field",
        "kind"
      ],
      "properties": {
        "text_or_field": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "PROPOSITION",
            "JUDGMENT",
            "CONSTRAINT",
            "ACTION",
            "STATE_WRITE",
            "GATE",
            "FALLBACK",
            "POOL_ENTRY",
            "SUPPORT_NODE",
            "EXPOSURE_ANCHOR",
            "OTHER"
          ]
        }
      }
    },
    "semantic_role": {
      "enum": [
        "OBSERVATION",
        "UNSTABLE_INFORMATION",
        "ADOPTION",
        "COUPLING",
        "SEMANTIC_TRANSFORMATION",
        "AUTHORITY_MATERIALIZATION",
        "AMPLIFICATION",
        "STRUCTURAL_SUPPORT",
        "STABLE_POOL_ENTRY",
        "DIRECT_POOL_CONSUMPTION",
        "STRUCTURAL_EXPOSURE",
        "LEGACY_JUMP",
        "PERTURBATION_RESPONSE",
        "DRIVER_RESPONSE",
        "INERTIA",
        "RECOVERY",
        "NOT_ESTABLISHED"
      ]
    },
    "relation_type": {
      "enum": [
        "SUPPORTS",
        "CAUSES",
        "CONSTRAINS",
        "DEPENDS_ON",
        "ENABLES",
        "CONFLICTS_WITH",
        "REFRAMES",
        "DROPS",
        "RECONSTRUCTS",
        "TRANSFORMS_TO",
        "SUPPORTED_BY_STRUCTURE",
        "ENTERS_SHARED_POOL",
        "DIRECTLY_CONSUMED_FROM_POOL",
        "TRACED_TO_SOURCE",
        "AFFECTS_DESCENDANT",
        "MERE_VISIBILITY",
        "MERE_RELAY",
        "NOT_ESTABLISHED"
      ]
    },
    "structural_facts_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "alternative_interpretation": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim_status": {
      "enum": [
        "SUPPORTED",
        "SUPPORTED_CANDIDATE",
        "NOT_ESTABLISHED",
        "CONTRADICTED"
      ]
    },
    "causal_design_support": {
      "type": "boolean"
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relation_type": {
            "const": "CAUSES"
          },
          "causal_design_support": {
            "const": false
          }
        },
        "required": [
          "relation_type",
          "causal_design_support"
        ]
      },
      "then": {
        "properties": {
          "claim_status": {
            "enum": [
              "SUPPORTED_CANDIDATE",
              "NOT_ESTABLISHED",
              "CONTRADICTED"
            ]
          }
        }
      }
    }
  ]
}
