{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/experimental_variable_registry_v0.1.schema.json",
  "title": "Reality Bias Experimental Variable Registry v0.1",
  "type": "object",
  "required": ["schema", "version", "status", "variables"],
  "properties": {
    "schema": {"const": "RB-EXPERIMENTAL-VARIABLE-REGISTRY-v0.1"},
    "version": {"const": "0.1"},
    "status": {"type": "string"},
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variable_id",
          "family",
          "stage",
          "target_boundary_family",
          "control_level",
          "manipulation_level",
          "held_constant_fields",
          "expected_observable_family",
          "evidence_requirements"
        ],
        "properties": {
          "variable_id": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "enum": ["PRE", "MID", "POST", "STRUCTURE"]},
          "target_boundary_family": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "control_level": {},
          "manipulation_level": {},
          "held_constant_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_observable_family": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}