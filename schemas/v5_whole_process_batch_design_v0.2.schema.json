    },
    "theory_contract_path": {
      "type": "string"
    },
    "measurement_contract_path": {
      "type": "string"
    },
    "scout_config_path": {
      "type": "string"
    },
    "experiment_profile_path": {
      "type": "string"
    },
    "theory_report_standard_path": {
