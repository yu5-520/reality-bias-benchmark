{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/semantic_audit_record_v0.1.schema.json",
  "title": "Reality Bias Semantic Audit Record v0.1",
  "type": "object",
  "required": [
    "schema",
    "audit_id",
    "auditor",
    "scope",
    "evidence_binding",
    "source_proposition",
    "semantic_role",
    "relation_type",
    "structural_facts_used",
    "interpretation",
    "claim_status",
    "boundary"
  ],
  "properties": {
    "schema": {"const": "RB-SEMANTIC-AUDIT-RECORD-v0.1"},
    "audit_id": {"type": "string", "minLength": 1},
    "auditor": {
      "type": "object",
      "required": ["auditor_kind", "auditor_id", "blind_to_prior_semantic_labels"],
      "properties": {
        "auditor_kind": {"enum": ["MODEL", "HUMAN", "HYBRID"]},
        "auditor_id": {"type": "string", "minLength": 1},
        "blind_to_prior_semantic_labels": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["experiment_stage", "trace_id"],
      "properties": {
        "experiment_stage": {"enum": ["R2", "R3", "R4", "R5", "R6", "R7", "R2-R4", "R5-R6", "R2-R7"]},
        "condition_id": {"type": ["string", "null"]},
        "replicate_id": {"type": ["string", "integer", "null"]},
        "trace_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence_binding": {
      "type": "object",
      "required": ["raw_evidence_ref", "evidence_pointers"],
      "properties": {
        "raw_evidence_ref": {"type": "string", "minLength": 1},
        "raw_evidence_hash": {"type": ["string", "null"]},
        "structural_bundle_ref": {"type": ["string", "null"]},
        "structural_bundle_hash": {"type": ["string", "null"]},
        "evidence_pointers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["pointer"],
            "properties": {
              "pointer": {"type": "string", "minLength": 1},
              "minimal_excerpt_or_field": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "source_proposition": {
      "type": "object",
      "required": ["text_or_field", "epistemic_status"],
      "properties": {
        "text_or_field": {"type": "string", "minLength": 1},
        "epistemic_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "downstream_proposition_or_action": {
      "type": ["object", "null"],
      "properties": {
        "text_or_field": {"type": "string", "minLength": 1},
        "kind": {"enum": ["PROPOSITION", "JUDGMENT", "CONSTRAINT", "ACTION", "STATE_WRITE", "GATE", "FALLBACK", "OTHER"]}
      },
      "required": ["text_or_field", "kind"],
      "additionalProperties": false
    },
    "semantic_role": {
      "enum": [
        "OBSERVATION",
        "ADOPTION",
        "COUPLING",
        "AUTHORITY_MATERIALIZATION",
        "AMPLIFICATION",
        "JUMP",
        "PERTURBATION_RESPONSE",
        "INERTIA",
        "RECOVERY",
        "NOT_ESTABLISHED"
      ]
    },
    "relation_type": {
      "enum": [
        "SUPPORTS",
        "CAUSES",
        "CONSTRAINS",
        "DEPENDS_ON",
        "ENABLES",
        "CONFLICTS_WITH",
        "REFRAMES",
        "DROPS",
        "RECONSTRUCTS",
        "MERE_VISIBILITY",
        "MERE_RELAY",
        "NOT_ESTABLISHED"
      ]
    },
    "structural_facts_used": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "interpretation": {"type": "string", "minLength": 1},
    "alternative_interpretation": {"type": ["string", "null"]},
    "claim_status": {
      "enum": ["SUPPORTED", "SUPPORTED_CANDIDATE", "NOT_ESTABLISHED", "CONTRADICTED"]
    },
    "causal_design_support": {"type": "boolean", "default": false},
    "boundary": {"type": "string", "minLength": 1},
    "reviewer_notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"relation_type": {"const": "CAUSES"}}
      },
      "then": {
        "properties": {
          "claim_status": {"enum": ["SUPPORTED_CANDIDATE", "NOT_ESTABLISHED", "CONTRADICTED"]}
        }
      }
    }
  ],
  "additionalProperties": false
}