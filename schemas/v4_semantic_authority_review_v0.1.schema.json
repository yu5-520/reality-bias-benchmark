{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/v4_semantic_authority_review_v0.1.schema.json",
  "title": "Reality Bias v4 Semantic and Authority Review Record v0.1",
  "type": "object",
  "required": [
    "schema",
    "review_version",
    "review_record_id",
    "record_kind",
    "packet_id",
    "packet_hash",
    "evidence_batch_hash",
    "review_contract_hash",
    "reviewer",
    "judgments",
    "rationale",
    "confidence",
    "uncertainties",
    "evidence_refs",
    "created_at",
    "record_hash"
  ],
  "properties": {
    "schema": {"const": "RB-V4-SEMANTIC-AUTHORITY-REVIEW-v0.1"},
    "review_version": {"const": "0.1"},
    "review_record_id": {"type": "string", "minLength": 1},
    "record_kind": {"enum": ["independent", "recheck", "adjudication"]},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_hash": {"type": "string", "minLength": 1},
    "evidence_batch_hash": {"type": "string", "minLength": 1},
    "review_contract_hash": {"type": "string", "minLength": 1},
    "reviewer": {"type": "object"},
    "judgments": {"type": "object"},
    "rationale": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parent_review_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1},
    "record_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}