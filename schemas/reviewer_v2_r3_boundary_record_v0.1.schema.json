{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reviewer_v2_r3_boundary_record_v0.1.schema.json",
  "title": "Reviewer v2 R3 Boundary Record v0.1",
  "type": "object",
  "required": [
    "review_record_version",
    "review_layer",
    "review_record_id",
    "evidence_batch_hash",
    "packet_id",
    "target_ref",
    "reviewer",
    "semantic_adoption",
    "decision_effect",
    "lineage_outcome",
    "penetration_range_refs",
    "rationale",
    "confidence",
    "uncertainties",
    "evidence_refs"
  ],
  "properties": {
    "review_record_version": {"const": "R234-REVIEWER-V2-R3-BOUNDARY-RECORD-v0.1"},
    "review_layer": {"const": "R3"},
    "review_record_id": {"type": "string", "minLength": 1},
    "evidence_batch_hash": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object",
      "required": ["id", "type", "blind_to_prior_review", "blind_to_expected_mapping"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["model", "human"]},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "blind_to_prior_review": {"type": "boolean"},
        "blind_to_expected_mapping": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "semantic_adoption": {"enum": ["ADOPTED", "REJECTED", "NOT_USED", "UNCERTAIN", "NOT_APPLICABLE"]},
    "decision_effect": {"enum": ["EFFECTIVE", "NO_MATERIAL_EFFECT", "UNCERTAIN", "NOT_APPLICABLE"]},
    "lineage_outcome": {
      "enum": [
        "CORRECTED_BEFORE_EFFECT",
        "PRESERVED_AS_SAME_STATUS",
        "CERTAINTY_EROSION_PRECURSOR",
        "NEW_UNSUPPORTED_PROMOTION",
        "GOAL_SCOPE_EXPANSION_EFFECTIVE",
        "GOAL_FOCUS_SHIFT_EFFECTIVE",
        "UNCERTAIN",
        "NOT_APPLICABLE"
      ]
    },
    "penetration_range_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rationale": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "context_expansion_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "context_expansion_used": {"type": "boolean"},
    "created_at": {"type": ["string", "null"]},
    "usage": {"type": ["object", "null"]},
    "review_attempt_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
