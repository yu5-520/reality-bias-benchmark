{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/semantic_authority_review_contract_v0.1.schema.json",
  "title": "Reality Bias Semantic Authority Review Contract v0.1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "scientific_scope",
    "source_interfaces",
    "packet_bounds",
    "adjudication_questions",
    "authority_criteria",
    "output_enums",
    "review_rules",
    "non_claims"
  ],
  "properties": {
    "schema": {"const": "RB-SEMANTIC-AUTHORITY-REVIEW-CONTRACT-v0.1"},
    "version": {"const": "0.1"},
    "status": {"type": "string"},
    "scientific_scope": {"const": "BOUNDED_POST_HOC_SEMANTIC_AND_AUTHORITY_ADJUDICATION_ONLY"},
    "source_interfaces": {"type": "object", "minProperties": 4},
    "packet_bounds": {
      "type": "object",
      "required": ["max_behavior_events", "max_lineage_relations", "max_operational_crossings", "max_source_model_calls", "max_allowed_expansion_refs"],
      "properties": {
        "max_behavior_events": {"type": "integer", "minimum": 1},
        "max_lineage_relations": {"type": "integer", "minimum": 1},
        "max_operational_crossings": {"type": "integer", "minimum": 1},
        "max_source_model_calls": {"type": "integer", "minimum": 1},
        "max_allowed_expansion_refs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "adjudication_questions": {"type": "object", "minProperties": 5},
    "authority_criteria": {"type": "object", "minProperties": 5},
    "output_enums": {"type": "object", "minProperties": 6},
    "review_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}