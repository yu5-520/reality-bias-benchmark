{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-R8-DYNAMIC-CPR-EVENT-v0.2",
  "title": "R8 Dynamic CPR Permission-Penetration Event v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "run_id",
    "candidate_type",
    "permission_dimension",
    "start_ref",
    "end_ref",
    "evidence_refs",
    "root_lineage_refs",
    "shared_pool_refs",
    "independent_evidence_refs",
    "lineage_derived_support_refs",
    "operational_use_refs",
    "preceding_event_refs",
    "following_event_refs",
    "overlap_event_refs",
    "retrospective_boundary_refs",
    "coupling_edges",
    "adjudication_status"
  ],
  "properties": {
    "schema": {
      "const": "RB-R8-DYNAMIC-CPR-EVENT-v0.2"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_type": {
      "enum": [
        "C",
        "P",
        "R",
        "MULTI",
        "UNRESOLVED"
      ]
    },
    "permission_dimension": {
      "enum": [
        "INFORMATION",
        "COLLABORATION_EXECUTION",
        "TIME",
        "MULTI",
        "UNRESOLVED"
      ]
    },
    "r_form": {
      "enum": [
        "LINEAGE_PRESERVING_R",
        "RETROSPECTIVE_GENERATIVE_R",
        "NOT_APPLICABLE",
        "UNRESOLVED"
      ]
    },
    "start_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "end_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_lineage_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_pool_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage_derived_support_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_descendant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operational_use_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorized_boundary_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrospective_boundary_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reopened_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_side_modification_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_observable_semantic_compensation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_support_progression": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "independent_evidence_progression": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "operational_authority_progression": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preceding_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "following_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overlap_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coupling_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_type",
          "target_event_ref",
          "support_refs"
        ],
        "properties": {
          "edge_type": {
            "enum": [
              "C_DRIVES_P",
              "P_REINFORCES_C",
              "R_REOPENS_C",
              "R_REOPENS_P",
              "R_GENERATES_NEW_C",
              "R_GENERATES_NEW_P",
              "P_CREATES_RETROSPECTIVE_SURFACE",
              "C_SURVIVES_INTO_RETROSPECTIVE_WINDOW"
            ]
          },
          "target_event_ref": {
            "type": "string"
          },
          "support_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "counter_explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "mechanism_notes": {
      "type": "string"
    },
    "adjudication_status": {
      "enum": [
        "UNREVIEWED",
        "SUPPORTED",
        "SUPPORTED_CANDIDATE",
        "NOT_ESTABLISHED",
        "CONTRADICTED",
        "UNRESOLVED",
        "NON_CPR",
        "NOT_APPLICABLE"
      ]
    }
  }
}
