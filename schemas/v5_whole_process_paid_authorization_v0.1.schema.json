{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-V5-WHOLE-PROCESS-PAID-AUTHORIZATION-v0.1",
  "title": "Process Reality v5 Whole-Process Paid Authorization v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "authorization_phrase",
    "provider",
    "run_count",
    "per_run_max_calls",
    "per_run_spending_ceiling",
    "global_spending_ceiling",
    "currency",
    "pricing_policy",
    "manifest_sha256",
    "batch_design_hash",
    "arena_config_hash",
    "model_config_hash",
    "theory_contract_hash",
    "measurement_contract_hash",
    "scout_config_hash",
    "experiment_profile_hash",
    "code_commit_sha",
    "automatic_paid_evaluator",
    "driver_probe_authorized",
    "active_recovery_authorized",
    "no_outcome_aware_rerun",
    "authorization_hash"
  ],
  "properties": {
    "schema": {
      "const": "RB-V5-WHOLE-PROCESS-PAID-AUTHORIZATION-v0.1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_phrase": {
      "const": "CALL_REAL_V5_WHOLE_PROCESS_API"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "run_count": {
      "type": "integer",
      "minimum": 1
    },
    "per_run_max_calls": {
      "type": "integer",
      "minimum": 1
    },
    "per_run_spending_ceiling": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "global_spending_ceiling": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "pricing_policy": {
      "type": "object"
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 1
    },
    "batch_design_hash": {
      "type": "string",
      "minLength": 1
    },
    "arena_config_hash": {
      "type": "string",
      "minLength": 1
    },
    "model_config_hash": {
      "type": "string",
      "minLength": 1
    },
    "theory_contract_hash": {
      "type": "string",
      "minLength": 1
    },
    "measurement_contract_hash": {
      "type": "string",
      "minLength": 1
    },
    "scout_config_hash": {
      "type": "string",
      "minLength": 1
    },
    "experiment_profile_hash": {
      "type": "string",
      "minLength": 1
    },
    "code_commit_sha": {
      "type": "string",
      "minLength": 1
    },
    "automatic_paid_evaluator": {
      "const": false
    },
    "driver_probe_authorized": {
      "const": false
    },
    "active_recovery_authorized": {
      "const": false
    },
    "no_outcome_aware_rerun": {
      "const": true
    },
    "authorization_hash": {
      "type": "string",
      "minLength": 1
    }
  }
}
