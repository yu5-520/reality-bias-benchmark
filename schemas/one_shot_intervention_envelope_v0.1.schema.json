    "persistent_state_mutation": {"const": false},
    "experiment_origin_reinjection_forbidden": {"const": true},
    "source_event_index": {"type": "integer", "minimum": 0},
    "envelope_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
