  "properties": {
    "schema": {"const": "RB-ONE-SHOT-JUMP-INTERVENTION-v0.1"},
    "variable_id": {"const": "ONE_SHOT_JUMP_EPISTEMIC_PERTURBATION"},
    "delivery_policy": {"const": "FIRST_POST_JUMP_AGENT_TURN"},
    "temporal_scope": {"const": "ONE_EXPOSURE_ONLY"},
