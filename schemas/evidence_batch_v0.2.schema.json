{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "R2-EVIDENCE-BATCH-v0.2",
  "type": "object",
  "required": ["version", "evidence_batch_hash", "status", "review_status", "manifest_sha256", "traces_sha256", "code_commit_sha", "manifest_bindings"],
  "properties": {
    "version": {"const": "R2-EVIDENCE-BATCH-v0.2"},
    "evidence_batch_hash": {"type": "string"},
    "status": {"enum": [
      "RUN_COMPLETE_PENDING_REVIEW",
      "OBSERVATION_FINISHED_WITH_CENSORING_PENDING_REVIEW",
      "RUN_FINISHED_WITH_INCOMPLETE_EVIDENCE_PENDING_REVIEW"
    ]},
    "review_status": {"const": "PENDING_REVIEW"},
    "manifest_sha256": {"type": "string"},
    "traces_sha256": {"type": "string"},
    "errors_sha256": {"type": ["string", "null"]},
    "code_commit_sha": {"type": "string"},
    "manifest_bindings": {"type": "array"}
  }
}
