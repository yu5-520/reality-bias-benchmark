{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/paid_subject_authorization_v0.1.schema.json",
  "title": "Reality Bias Paid Subject Authorization v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "experiment_family",
    "authorization_phrase",
    "provider",
    "model_config_path",
    "model_config_version",
    "pair_count",
    "run_count",
    "max_subject_calls",
    "spending_ceiling",
    "currency",
    "pricing_policy",
    "manifest_sha256",
    "arena_config_sha256",
    "structured_policy_sha256",
    "model_config_sha256",
    "automatic_paid_evaluator",
    "semantic_review",
    "authorization_hash"
  ],
  "properties": {
    "schema": {"const": "RB-PAID-SUBJECT-AUTHORIZATION-v0.1"},
    "experiment_family": {"type": "string", "minLength": 1},
    "authorization_phrase": {"const": "CALL_REAL_R7_API"},
    "provider": {"type": "string", "minLength": 1},
    "model_config_path": {"type": "string", "minLength": 1},
    "model_config_version": {"type": ["string", "null"]},
    "model_alias": {"type": ["string", "null"]},
    "pair_count": {"type": "integer", "minimum": 1},
    "run_count": {"type": "integer", "minimum": 2},
    "max_subject_calls": {"type": "integer", "minimum": 1},
    "spending_ceiling": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "pricing_policy": {"type": "object"},
    "manifest_sha256": {"type": "string", "minLength": 1},
    "arena_config_sha256": {"type": "string", "minLength": 1},
    "structured_policy_sha256": {"type": "string", "minLength": 1},
    "model_config_sha256": {"type": "string", "minLength": 1},
    "code_commit_sha": {"type": ["string", "null"]},
    "automatic_paid_evaluator": {"const": false},
    "semantic_review": {"const": "DEFERRED_APPEND_ONLY"},
    "financial_guard_note": {"type": "string", "minLength": 1},
    "authorization_hash": {"type": "string", "minLength": 1}
  }
}
