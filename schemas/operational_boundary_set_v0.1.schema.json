{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/operational_boundary_set_v0.1.schema.json",
  "title": "Reality Bias Operational Boundary Set v0.1",
  "type": "object",
  "required": ["schema", "version", "status", "scientific_scope", "source_behavior_schema", "boundaries", "non_claims"],
  "properties": {
    "schema": {"const": "RB-OPERATIONAL-BOUNDARY-SET-v0.1"},
    "version": {"const": "0.1"},
    "status": {"type": "string"},
    "scientific_scope": {"const": "MECHANICAL_OPERATIONAL_CROSSING_ONLY"},
    "source_behavior_schema": {"const": "RB-BEHAVIOR-EVENT-v0.1"},
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operational_boundary_id", "measurement_boundary_id", "action_type", "realization_status", "authority_class", "description"],
        "properties": {
          "operational_boundary_id": {"type": "string", "minLength": 1},
          "measurement_boundary_id": {"type": "string", "minLength": 1},
          "action_type": {"type": "string", "minLength": 1},
          "realization_status": {"enum": ["PROPOSAL", "REALIZED", "BLOCKED", "FAILED"]},
          "require_state_hash_change": {"type": "boolean"},
          "authority_class": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "non_claims": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}