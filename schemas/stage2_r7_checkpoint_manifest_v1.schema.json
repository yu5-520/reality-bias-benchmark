{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-STAGE2-R7-CHECKPOINT-MANIFEST-v1",
  "title": "Stage-II R7 prospective checkpoint manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "checkpoint_id",
    "checkpoint_hash",
    "system_id",
    "group_id",
    "run_id",
    "task_id",
    "event_ref",
    "adapter_id",
    "framework_binding",
    "native_state_sha256",
    "application_state_sha256",
    "model_visible_context_sha256",
    "remaining_horizon",
    "external_carrier_refs",
    "restore_capability",
    "replication_binding"
  ],
  "properties": {
    "schema": {"const": "RB-STAGE2-R7-CHECKPOINT-MANIFEST-v1"},
    "checkpoint_id": {"type": "string", "pattern": "^rbcp:"},
    "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "system_id": {"type": "string"},
    "group_id": {"type": "string"},
    "run_id": {"type": "string"},
    "task_id": {"enum": ["T1", "T2", "T3"]},
    "event_ref": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "framework_binding": {"type": "object"},
    "native_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "application_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_visible_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_carrier_refs": {"type": "array", "items": {"type": "object"}},
    "restore_capability": {"enum": ["FULL_NATIVE", "PARTIAL_NATIVE", "UNSUPPORTED"]},
    "replication_binding": {"type": "object"}
  }
}
