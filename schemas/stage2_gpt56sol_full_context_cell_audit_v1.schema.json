{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2-gpt56sol-full-context-cell-audit-v1",
  "title": "Stage-II GPT-5.6 Sol Full-Context Cell Audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewer",
    "group_id",
    "cell_id",
    "x_id",
    "task_id",
    "system_condition",
    "input_packet_sha256",
    "route_summary",
    "semantic_nodes",
    "semantic_edges",
    "cpr_events",
    "cpr_transitions",
    "dynamic_topology",
    "healthy_alternatives",
    "not_established"
  ],
  "properties": {
    "schema": {
      "const": "stage2-gpt56sol-full-context-cell-audit-v1"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "execution_mode",
        "monitor_runtime_bundle_read",
        "blind_reference_labels_read",
        "blind_reference_records_read",
        "deepseek_full_context_pilot_outputs_read"
      ],
      "properties": {
        "model": {
          "const": "GPT-5.6 Sol"
        },
        "execution_mode": {
          "const": "CHATGPT_NATIVE_REASONING"
        },
        "monitor_runtime_bundle_read": {
          "const": false
        },
        "blind_reference_labels_read": {
          "const": false
        },
        "blind_reference_records_read": {
          "const": false
        },
        "deepseek_full_context_pilot_outputs_read": {
          "const": false
        }
      }
    },
    "group_id": {
      "enum": [
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "cell_id": {
      "type": "string",
      "pattern": "^X[1-7]-T[1-3]$"
    },
    "x_id": {
      "enum": [
        "X1",
        "X2",
        "X3",
        "X4",
        "X5",
        "X6",
        "X7"
      ]
    },
    "task_id": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "system_condition": {
      "type": "string",
      "minLength": 1
    },
    "input_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "route_summary": {
      "type": "object"
    },
    "semantic_nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "semantic_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cpr_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cpr_transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dynamic_topology": {
      "type": "object"
    },
    "healthy_alternatives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "not_established": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
