{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/v4_bounded_review_packet_v0.1.schema.json",
  "title": "Reality Bias v4 Bounded Review Packet v0.1",
  "type": "object",
  "required": [
    "schema",
    "packet_version",
    "packet_id",
    "trajectory_id",
    "evidence_batch_hash",
    "v4_research_binding_hash",
    "review_contract_binding",
    "packet_generator_binding",
    "jump_candidate",
    "root_behavior_event",
    "recorded_contract_excerpt",
    "lineage_window",
    "operational_window",
    "retrospective_window",
    "review_questions",
    "allowed_evidence_refs",
    "semantic_status",
    "packet_hash"
  ],
  "properties": {
    "schema": {"const": "RB-V4-BOUNDED-REVIEW-PACKET-v0.1"},
    "packet_version": {"const": "0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": ["string", "null"]},
    "evidence_batch_hash": {"type": "string", "minLength": 1},
    "v4_research_binding_hash": {"type": "string", "minLength": 1},
    "review_contract_binding": {"type": "object"},
    "packet_generator_binding": {"type": "object"},
    "jump_candidate": {"type": "object"},
    "root_behavior_event": {"type": "object"},
    "recorded_contract_excerpt": {"type": "object"},
    "lineage_window": {"type": "object"},
    "operational_window": {"type": "object"},
    "retrospective_window": {"type": "object"},
    "review_questions": {"type": "object"},
    "allowed_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "omission_report": {"type": "object"},
    "semantic_status": {"const": "NOT_ADJUDICATED"},
    "warning": {"type": "string"},
    "packet_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}