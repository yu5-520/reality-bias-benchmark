{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-ENGINEERING-STRUCTURAL-SEMANTIC-AUDIT-v0.1",
  "title": "Reality Bias Engineering Structural Semantic Audit v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audit_id",
    "case_id",
    "domain_id",
    "target_state_key",
    "reviewer",
    "evidence_binding",
    "engineering_lifecycle",
    "r7_p_route",
    "r7_s_route",
    "repair_scope",
    "engineering_semantic_ledger",
    "p_vs_s_semantic_contrast",
    "engineering_case_class",
    "claim_boundaries",
    "audit_hash"
  ],
  "properties": {
    "schema": {
      "const": "RB-ENGINEERING-STRUCTURAL-SEMANTIC-AUDIT-v0.1"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "enum": [
        "supply_chain",
        "software_engineering",
        "finance"
      ]
    },
    "target_state_key": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "blind_to_prior_semantic_labels"
      ],
      "properties": {
        "kind": {
          "enum": [
            "MODEL",
            "HUMAN",
            "HYBRID"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "blind_to_prior_semantic_labels": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r5_complete_route_audit_ref",
        "r5_complete_route_audit_hash",
        "r6_repair_anchor_ref",
        "r6_content_address",
        "r6_gate_hash",
        "r6_closure_hash",
        "r6_repair_packet_hash",
        "r7_p_run_id",
        "r7_s_run_id",
        "r7_structural_comparison_hash",
        "r7_semantic_audit_hash"
      ],
      "properties": {
        "r5_complete_route_audit_ref": {
          "type": "string",
          "minLength": 1
        },
        "r5_complete_route_audit_hash": {
          "type": "string",
          "minLength": 16
        },
        "r6_repair_anchor_ref": {
          "type": "string",
          "minLength": 1
        },
        "r6_content_address": {
          "type": "string",
          "minLength": 16
        },
        "r6_gate_hash": {
          "type": "string",
          "minLength": 16
        },
        "r6_closure_hash": {
          "type": "string",
          "minLength": 16
        },
        "r6_repair_packet_hash": {
          "type": "string",
          "minLength": 16
        },
        "r7_p_run_id": {
          "type": "string",
          "minLength": 1
        },
        "r7_s_run_id": {
          "type": "string",
          "minLength": 1
        },
        "r7_structural_comparison_hash": {
          "type": "string",
          "minLength": 16
        },
        "r7_semantic_audit_hash": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "engineering_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "R5_I",
        "R6",
        "R7_P",
        "R7_S"
      ],
      "properties": {
        "R5_I": {
          "$ref": "#/$defs/operator"
        },
        "R6": {
          "$ref": "#/$defs/operator"
        },
        "R7_P": {
          "$ref": "#/$defs/operator"
        },
        "R7_S": {
          "$ref": "#/$defs/operator"
        }
      }
    },
    "r7_p_route": {
      "$ref": "#/$defs/route"
    },
    "r7_s_route": {
      "$ref": "#/$defs/route"
    },
    "repair_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_anchor_ref",
        "target_semantic_id",
        "lineage_completeness_status",
        "allowed_repair_operations",
        "repair_application_hash",
        "invalidated_refs",
        "reopened_model_call_refs",
        "recomputed_descendant_refs",
        "preserved_unrelated_structure",
        "preserved_unrelated_refs",
        "old_lineage_reentry_detected",
        "old_lineage_reentry_refs",
        "target_final_status",
        "verification_hash",
        "post_repair_watch_status"
      ],
      "properties": {
        "repair_anchor_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_semantic_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_completeness_status": {
          "const": "COMPLETE_FOR_AUTHORIZED_REPAIR"
        },
        "allowed_repair_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "repair_application_hash": {
          "type": "string",
          "minLength": 16
        },
        "invalidated_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reopened_model_call_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recomputed_descendant_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved_unrelated_structure": {
          "const": true
        },
        "preserved_unrelated_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "old_lineage_reentry_detected": {
          "type": "boolean"
        },
        "old_lineage_reentry_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_final_status": {
          "type": "string",
          "minLength": 1
        },
        "verification_hash": {
          "type": "string",
          "minLength": 16
        },
        "post_repair_watch_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engineering_semantic_ledger": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ledger_id",
          "stage",
          "dimension",
          "structural_fact",
          "engineering_semantic_meaning",
          "evidence_refs",
          "claim_status"
        ],
        "properties": {
          "ledger_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "R5_I",
              "R6",
              "R7_P",
              "R7_S",
              "R7_P_VS_R7_S"
            ]
          },
          "dimension": {
            "enum": [
              "CONTROL_SURFACE",
              "LOCALIZATION",
              "CONTENT_ADDRESSING",
              "INVALIDATION",
              "REOPEN",
              "RECOMPUTE",
              "PRESERVATION",
              "REENTRY",
              "AUTHORITY_RESULT",
              "ENDPOINT_PROCESS_RELATION",
              "HORIZON"
            ]
          },
          "structural_fact": {
            "type": "string",
            "minLength": 1
          },
          "engineering_semantic_meaning": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "claim_status": {
            "enum": [
              "DIRECTLY_EVIDENCED",
              "SUPPORTED",
              "SUPPORTED_CANDIDATE",
              "NOT_ESTABLISHED",
              "NOT_ADJUDICATED"
            ]
          }
        }
      }
    },
    "p_vs_s_semantic_contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistent_semantics",
        "structured_repair_semantics",
        "action_plan_relation",
        "process_relation",
        "old_fact_reentry_semantic_interpretation",
        "intervention_mode_semantic_distinction",
        "intervention_superiority"
      ],
      "properties": {
        "persistent_semantics": {
          "type": "string",
          "minLength": 1
        },
        "structured_repair_semantics": {
          "type": "string",
          "minLength": 1
        },
        "action_plan_relation": {
          "type": "string",
          "minLength": 1
        },
        "process_relation": {
          "enum": [
            "MATERIAL_DIVERGENCE",
            "RECONVERGENCE_AFTER_RECOMPUTE"
          ]
        },
        "old_fact_reentry_semantic_interpretation": {
          "type": "string",
          "minLength": 1
        },
        "intervention_mode_semantic_distinction": {
          "const": "SUPPORTED"
        },
        "intervention_superiority": {
          "const": "NOT_ESTABLISHED"
        }
      }
    },
    "engineering_case_class": {
      "enum": [
        "SELECTIVE_RECOMPUTE_PARAMETER_DIVERGENCE",
        "SELECTIVE_RECOMPUTE_ACTION_RECOMPOSITION",
        "REPAIR_RECONVERGENCE_WITH_FRESH_AUTHORITY_REGENERATION",
        "REPAIR_RECONVERGENCE_WITH_COMPATIBLE_DECISION_REAFFIRMATION"
      ]
    },
    "claim_boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "audit_hash": {
      "type": "string",
      "minLength": 16
    }
  },
  "$defs": {
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "engineering_role",
        "control_surface",
        "underlying_shared_state_mutation",
        "semantic_purpose",
        "evidence_refs"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "engineering_role": {
          "type": "string",
          "minLength": 1
        },
        "control_surface": {
          "type": "string",
          "minLength": 1
        },
        "underlying_shared_state_mutation": {
          "type": "boolean"
        },
        "semantic_purpose": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "arm_id",
        "complete_route_verified",
        "fixed_horizon_censored",
        "direct_exposure_count",
        "nodes",
        "terminal"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "arm_id": {
          "enum": [
            "R7_P_PERSISTENT_SEMANTIC",
            "R7_S_STRUCTURED_LINEAGE_REPAIR"
          ]
        },
        "complete_route_verified": {
          "const": true
        },
        "fixed_horizon_censored": {
          "const": true
        },
        "direct_exposure_count": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route_index",
              "turn",
              "agent_role",
              "call_ref",
              "decision_summary",
              "write_summaries",
              "status"
            ],
            "properties": {
              "route_index": {
                "type": "integer",
                "minimum": 0
              },
              "turn": {
                "type": "integer",
                "minimum": 0
              },
              "agent_role": {
                "type": "string",
                "minLength": 1
              },
              "call_ref": {
                "type": "string",
                "minLength": 1
              },
              "decision_summary": {
                "type": "string"
              },
              "write_summaries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_status",
            "termination_reason",
            "terminal_outcome_is_primary"
          ],
          "properties": {
            "run_status": {
              "type": "string",
              "minLength": 1
            },
            "termination_reason": {
              "type": "string",
              "minLength": 1
            },
            "terminal_outcome_is_primary": {
              "const": false
            }
          }
        }
      }
    }
  }
}
