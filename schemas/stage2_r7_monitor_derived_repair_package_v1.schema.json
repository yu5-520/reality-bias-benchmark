{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-STAGE2-R7-MONITOR-DERIVED-REPAIR-PACKAGE-v1",
  "title": "Stage-II R7 Monitor-Derived Repair Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "source_cell",
    "prefix_cutoff_ref",
    "monitor_evidence_refs",
    "pressure_refs",
    "support_refs",
    "ancestor_refs",
    "descendant_refs",
    "affected_closure_refs",
    "preserve_refs",
    "repair_anchor_ref",
    "content_address",
    "detection_surface",
    "allowed_repair_surface",
    "native_capability_requirements",
    "forbidden_mutations",
    "parent_reconstruction",
    "repair_gate_status",
    "post_repair_watch",
    "package_hash"
  ],
  "properties": {
    "schema": {"const": "RB-STAGE2-R7-MONITOR-DERIVED-REPAIR-PACKAGE-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "source_cell": {"type": "string", "pattern": "^X[1-7]-T[1-3]$"},
    "prefix_cutoff_ref": {"type": "string", "minLength": 1},
    "monitor_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pressure_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "support_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ancestor_refs": {"type": "array", "items": {"type": "string"}},
    "descendant_refs": {"type": "array", "items": {"type": "string"}},
    "affected_closure_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preserve_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "repair_anchor_ref": {"type": "string", "minLength": 1},
    "content_address": {"type": "string", "minLength": 1},
    "detection_surface": {"type": "string", "minLength": 1},
    "allowed_repair_surface": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "native_capability_requirements": {"type": "array", "items": {"type": "string"}},
    "forbidden_mutations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parent_reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parent_hash_refs", "future_evidence_used"],
      "properties": {
        "status": {"enum": ["VERIFIED", "BLOCKED", "PENDING"]},
        "parent_hash_refs": {"type": "array", "items": {"type": "string"}},
        "future_evidence_used": {"const": false}
      }
    },
    "repair_gate_status": {
      "enum": [
        "COMPLETE_FOR_STRUCTURED_REPAIR",
        "NO_REPAIR_REQUIRED",
        "LINEAGE_GAP_BLOCKED",
        "PARENT_RECONSTRUCTION_BLOCKED",
        "NATIVE_CAPABILITY_BLOCKED",
        "SAFETY_BOUNDARY_BLOCKED"
      ]
    },
    "post_repair_watch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_support_reentry", "new_support_emergence", "authority_regeneration", "scope_reopening", "carrier_migration"],
      "properties": {
        "old_support_reentry": {"type": "boolean"},
        "new_support_emergence": {"type": "boolean"},
        "authority_regeneration": {"type": "boolean"},
        "scope_reopening": {"type": "boolean"},
        "carrier_migration": {"type": "boolean"}
      }
    },
    "package_hash": {"type": "string", "minLength": 1}
  }
}
