{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RB-PROCESS-INTEGRITY-LINEAGE-RECORD-v0.3",
  "title": "Process Integrity Lineage Record v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "record_type",
    "trace_root_ref",
    "descendant_refs",
    "carrier_refs",
    "relation_evidence_refs",
    "structural_support_refs",
    "pool_entry_refs",
    "exposure_anchor_refs",
    "potentially_affected_closure",
    "evidence_supported_affected_closure",
    "candidate_intervention_surface_refs",
    "repair_closure",
    "preserved_refs",
    "scientific_status"
  ],
  "properties": {
    "schema": {
      "const": "RB-PROCESS-INTEGRITY-LINEAGE-RECORD-v0.3"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "PASSIVE_LINEAGE",
        "R5_SCOUTED_REGION",
        "R6_SUPPORT_TRACE",
        "R7_AFFECTED_CLOSURE",
        "R7_RECOVERY_REVISION"
      ]
    },
    "legacy_root_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_root_ref": {
      "type": "string",
      "minLength": 1
    },
    "detection_surface_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_intervention_surface_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "descendant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "carrier_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relation_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "structural_support_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "pool_entry_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "exposure_anchor_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "potentially_affected_closure": {
      "$ref": "#/$defs/closure"
    },
    "evidence_supported_affected_closure": {
      "$ref": "#/$defs/closure"
    },
    "mechanically_required_replay_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "candidate_intervention_surface_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repair_closure": {
      "$ref": "#/$defs/closure"
    },
    "preserved_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authority_condition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "prior_revision_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "repaired_revision_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_revision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reopen_plan_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "old_lineage_reentry_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "censoring_status": {
      "enum": [
        "UNCENSORED",
        "EARLY_NATURAL_TERMINATION",
        "HORIZON_LIMIT",
        "MISSING_SOURCE_EVIDENCE",
        "OTHER_UNRESOLVED"
      ]
    },
    "scientific_status": {
      "enum": [
        "RAW_OR_STRUCTURAL_EVIDENCE",
        "ENGINEERING_ONLY_NOT_SCIENTIFIC_EVIDENCE",
        "NOT_ADJUDICATED",
        "ADJUDICATED_APPEND_ONLY"
      ]
    }
  },
  "$defs": {
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refs",
        "closure_hash"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "closure_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
