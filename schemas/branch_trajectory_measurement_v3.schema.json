{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/branch_trajectory_measurement_v3.schema.json",
  "title": "Reality Bias Branch Trajectory Measurement v3.0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "measurement_version",
    "run_id",
    "branch_id",
    "branch_hash",
    "parent_trace_hash",
    "parent_state_hash",
    "branch_start_state_hash",
    "parent_turn",
    "branch_start_turn",
    "parent_event_count",
    "branch_start_event_count",
    "continuation_turn_count",
    "continuation_call_count",
    "continuation_event_count",
    "continuation_realized_event_count",
    "realized_authority_event_count",
    "realized_operational_event_count",
    "structural_candidate_count",
    "semantic_status",
    "warning",
    "measurement_hash"
  ],
  "properties": {
    "schema": {"const": "RB-BRANCH-TRAJECTORY-MEASUREMENT-v3.0.1"},
    "measurement_version": {"const": "RB-TRAJECTORY-MEASUREMENT-v3.0.1"},
    "run_id": {"type": ["string", "null"]},
    "run_status": {"type": ["string", "null"]},
    "evidence_batch_hash": {"type": "string"},
    "branch_id": {"type": ["string", "null"]},
    "branch_hash": {"type": ["string", "null"]},
    "parent_trace_hash": {"type": ["string", "null"]},
    "parent_state_hash": {"type": ["string", "null"]},
    "branch_start_state_hash": {"type": ["string", "null"]},
    "intervention_hash": {"type": ["string", "null"]},
    "intervention_applied_before_continuation": {"type": ["boolean", "null"]},
    "parent_turn": {"type": ["integer", "null"], "minimum": 0},
    "branch_start_turn": {"type": "integer", "minimum": 0},
    "parent_event_count": {"type": ["integer", "null"], "minimum": 0},
    "branch_start_event_count": {"type": "integer", "minimum": 0},
    "continuation_turn_count": {"type": "integer", "minimum": 0},
    "continuation_call_count": {"type": "integer", "minimum": 0},
    "continuation_event_count": {"type": "integer", "minimum": 0},
    "continuation_realized_event_count": {"type": "integer", "minimum": 0},
    "continuation_action_type_counts": {"type": "object"},
    "continuation_realized_action_type_counts": {"type": "object"},
    "continuation_actor_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "continuation_actor_count": {"type": "integer", "minimum": 0},
    "realized_authority_event_count": {"type": "integer", "minimum": 0},
    "realized_operational_event_count": {"type": "integer", "minimum": 0},
    "structural_candidate_count": {"type": "integer", "minimum": 0},
    "structural_candidate_type_counts": {"type": "object"},
    "structural_candidate_ids": {"type": "array"},
    "final_state_hash": {"type": "string"},
    "final_answer_hash": {"type": "string"},
    "usage_summary": {"type": "object"},
    "semantic_status": {
      "type": "object",
      "required": ["C", "P", "R", "semantic_adoption", "authority_penetration", "decision_effective", "recovery"],
      "properties": {
        "C": {"const": "NOT_ADJUDICATED"},
        "P": {"const": "NOT_ADJUDICATED"},
        "R": {"const": "NOT_ADJUDICATED"},
        "semantic_adoption": {"const": "NOT_ADJUDICATED"},
        "authority_penetration": {"const": "NOT_ADJUDICATED"},
        "decision_effective": {"const": "NOT_ADJUDICATED"},
        "recovery": {"const": "NOT_ADJUDICATED"}
      }
    },
    "warning": {"type": "string", "minLength": 1},
    "measurement_hash": {"type": "string", "minLength": 1}
  }
}
