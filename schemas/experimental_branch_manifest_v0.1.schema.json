{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/experimental_branch_manifest_v0.1.schema.json",
  "title": "Reality Bias Experimental Branch Manifest v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "branch_id",
    "parent_trace_hash",
    "parent_state_hash",
    "intervention_spec",
    "intervention_hash",
    "replicate_index",
    "created_from_frozen_parent",
    "provider_internal_state_replayed",
    "branch_hash"
  ],
  "properties": {
    "schema": {"const": "RB-EXPERIMENTAL-BRANCH-v0.1"},
    "branch_id": {"type": "string", "minLength": 1},
    "parent_trace_hash": {"type": "string", "minLength": 1},
    "parent_state_hash": {"type": "string", "minLength": 1},
    "anchor_ref": {"type": ["string", "null"]},
    "intervention_spec": {"type": "object"},
    "intervention_hash": {"type": "string", "minLength": 1},
    "replicate_index": {"type": "integer", "minimum": 0},
    "created_from_frozen_parent": {"const": true},
    "model_identity": {},
    "config_identity": {},
    "code_identity": {},
    "provider_internal_state_replayed": {"const": false},
    "branch_hash": {"type": "string", "minLength": 1}
  }
}
