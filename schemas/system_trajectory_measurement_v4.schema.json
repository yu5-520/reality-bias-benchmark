{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/system_trajectory_measurement_v4.schema.json",
  "title": "Reality Bias System Trajectory Measurement v4",
  "type": "object",
  "required": [
    "schema",
    "measurement_id",
    "trajectory_id",
    "source_trace_hash",
    "source_version",
    "termination_status",
    "behavior_event_count",
    "behavior_event_refs",
    "r2",
    "r3",
    "r4",
    "semantic_status"
  ],
  "properties": {
    "schema": {"const": "RB-SYSTEM-TRAJECTORY-MEASUREMENT-v4.0"},
    "measurement_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": ["string", "null"]},
    "parent_trace_hash": {"type": ["string", "null"]},
    "parent_state_hash": {"type": ["string", "null"]},
    "branch_start_state_hash": {"type": ["string", "null"]},
    "source_trace_hash": {"type": "string", "minLength": 1},
    "source_evidence_batch_hash": {"type": ["string", "null"]},
    "source_version": {"type": "string", "minLength": 1},
    "measurement_contract": {"type": "string", "default": "System Behavior Measurement v4"},
    "model_config_hash": {"type": ["string", "null"]},
    "code_sha": {"type": ["string", "null"]},
    "termination_status": {"type": "string"},
    "behavior_event_count": {"type": "integer", "minimum": 0},
    "behavior_event_refs": {"type": "array", "items": {"type": "string"}},
    "r2": {
      "type": "object",
      "required": ["jump_candidate_count", "first_jump_candidate_ref"],
      "properties": {
        "jump_candidate_count": {"type": "integer", "minimum": 0},
        "jump_candidate_refs": {"type": "array", "items": {"type": "string"}},
        "first_jump_candidate_ref": {"type": ["string", "null"]},
        "first_jump_turn": {"type": ["integer", "null"], "minimum": 0},
        "jump_type_counts": {"type": "object"}
      },
      "additionalProperties": true
    },
    "r3": {
      "type": "object",
      "required": ["descendant_event_count", "affected_agent_count"],
      "properties": {
        "descendant_event_count": {"type": "integer", "minimum": 0},
        "affected_agent_count": {"type": "integer", "minimum": 0},
        "operational_boundary_crossing_count": {"type": "integer", "minimum": 0},
        "penetration_status": {"type": "string"},
        "post_jump_persistence": {"type": ["number", "integer", "string", "null"]},
        "provenance_retention_status": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "r4": {
      "type": "object",
      "required": ["retrospective_window_count", "semantic_r_status"],
      "properties": {
        "retrospective_window_count": {"type": "integer", "minimum": 0},
        "retrospective_window_refs": {"type": "array", "items": {"type": "string"}},
        "semantic_r_status": {"type": "string"},
        "recovery_status": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "r5_mid": {
      "type": "object",
      "required": [
        "branch_start_anchor_hash",
        "state_key",
        "state_status",
        "anchor_visible_agent_turn_count",
        "potential_downstream_event_count",
        "potential_downstream_operational_crossing_count",
        "semantic_reliance_status",
        "authority_penetration_status",
        "causal_effect_status"
      ],
      "properties": {
        "branch_start_anchor_hash": {"type": "string", "minLength": 1},
        "state_key": {"type": "string", "minLength": 1},
        "state_status": {"type": "string", "minLength": 1},
        "anchor_visible_agent_turn_count": {"type": "integer", "minimum": 0},
        "anchor_visible_agent_ids": {"type": "array", "items": {"type": "string"}},
        "potential_downstream_event_count": {"type": "integer", "minimum": 0},
        "potential_downstream_relation_count": {"type": "integer", "minimum": 0},
        "potential_downstream_affected_agent_count": {"type": "integer", "minimum": 0},
        "potential_downstream_affected_agent_ids": {"type": "array", "items": {"type": "string"}},
        "potential_downstream_operational_crossing_count": {"type": "integer", "minimum": 0},
        "potential_downstream_authority_classes_reached": {"type": "array", "items": {"type": "string"}},
        "mechanical_anchor_reach_depth_candidate": {"type": ["integer", "null"], "minimum": 0},
        "semantic_reliance_status": {"const": "NOT_ADJUDICATED"},
        "authority_penetration_status": {"const": "NOT_ADJUDICATED"},
        "causal_effect_status": {"const": "NOT_ADJUDICATED"}
      },
      "additionalProperties": true
    },
    "experimental_variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable_id", "stage", "registry_hash"],
        "properties": {
          "variable_id": {"type": "string"},
          "family": {"type": ["string", "null"]},
          "stage": {"type": "string", "enum": ["PRE", "MID", "POST", "STRUCTURE"]},
          "assignment": {"type": ["string", "null"]},
          "level": {},
          "target_boundary_family": {"type": "array", "items": {"type": "string"}},
          "registry_hash": {"type": "string", "minLength": 1},
          "intervention_hash": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "semantic_status": {"type": "string", "enum": ["NOT_ADJUDICATED", "PARTIALLY_ADJUDICATED", "ADJUDICATED"]},
    "measurement_hash": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}