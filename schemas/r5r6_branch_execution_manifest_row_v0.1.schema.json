{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reality-bias/r5r6_branch_execution_manifest_row_v0.1.schema.json",
  "title": "Reality Bias R5/R6 Branch Execution Manifest Row v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "pair_id",
    "replicate_index",
    "logical_seed",
    "execution_order",
    "pair_order_pattern",
    "condition_id",
    "branch_id",
    "branch_hash",
    "parent_trace_hash",
    "parent_state_hash",
    "branch_start_state_hash",
    "intervention_hash",
    "domain_id",
    "domain_hash",
    "task_hash",
    "agent_pool_hash",
    "arena_config_path",
    "arena_config_hash",
    "model_config_path",
    "model_config_hash",
    "model_provider",
    "source_selection_record_hash",
    "branch_execution_code_commit_sha",
    "scientific_status",
    "automatic_paid_evaluator",
    "semantic_review"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "replicate_index": {"type": "integer", "minimum": 1},
    "logical_seed": {"type": "integer", "minimum": 1},
    "execution_order": {"enum": [1, 2]},
    "pair_order_pattern": {"enum": ["CONTROL_FIRST", "INTERVENTION_FIRST"]},
    "condition_id": {"enum": ["CONTROL_CONTINUATION", "STATUS_DOWNGRADE_INTERVENTION"]},
    "branch_id": {"type": "string", "minLength": 1},
    "branch_hash": {"type": "string", "minLength": 1},
    "parent_trace_hash": {"type": "string", "minLength": 1},
    "parent_state_hash": {"type": "string", "minLength": 1},
    "branch_start_state_hash": {"type": "string", "minLength": 1},
    "intervention_hash": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "domain_hash": {"type": "string", "minLength": 1},
    "task_hash": {"type": "string", "minLength": 1},
    "agent_pool_hash": {"type": "string", "minLength": 1},
    "arena_config_path": {"type": "string", "minLength": 1},
    "arena_config_hash": {"type": "string", "minLength": 1},
    "model_config_path": {"type": "string", "minLength": 1},
    "model_config_hash": {"type": "string", "minLength": 1},
    "model_provider": {"type": "string", "minLength": 1},
    "source_selection_record_hash": {"type": "string", "minLength": 1},
    "source_baseline_code_commit_sha": {"type": ["string", "null"]},
    "branch_execution_code_commit_sha": {"type": "string", "minLength": 1},
    "scientific_status": {"const": "CANDIDATE_UNTIL_EXPLICIT_REAL_RUN_FREEZE_AND_API_AUTHORIZATION"},
    "automatic_paid_evaluator": {"const": false},
    "semantic_review": {"const": "DEFERRED_APPEND_ONLY"}
  }
}
