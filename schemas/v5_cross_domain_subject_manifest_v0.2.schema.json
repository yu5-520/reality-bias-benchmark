{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"RB-V5-CROSS-DOMAIN-SUBJECT-MANIFEST-v0.2",
  "title":"Cross-Domain Held-Out Replication Subject Manifest Row v0.2",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","experiment_family","first_round_id","run_id","trial","logical_seed",
    "wave_id","wave_key","domain_wave_id","domain_id","cohort_role","subject_condition",
    "code_commit_sha","plan_path","plan_hash","domain_hash","task_hash","agent_pool_hash",
    "arena_config_path","arena_config_hash","model_config_path","model_config_hash",
    "theory_contract_path","theory_contract_hash","measurement_contract_path",
    "measurement_contract_hash","scout_config_path","scout_config_hash",
    "experiment_profile_path","experiment_profile_hash","automatic_paid_evaluator",
    "semantic_review","no_outcome_aware_rerun","scientific_status"
  ],
  "properties":{
    "schema":{"const":"RB-V5-CROSS-DOMAIN-SUBJECT-MANIFEST-v0.2"},
    "experiment_family":{"const":"PROCESS_REALITY_V5_CROSS_DOMAIN_FIRST_ROUND"},
    "first_round_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "trial":{"type":"integer","minimum":1,"maximum":30},
    "logical_seed":{"type":"integer","minimum":1},
    "wave_id":{"type":"integer","minimum":1,"maximum":6},
    "wave_key":{"type":"string","minLength":1},
    "domain_wave_id":{"type":"integer","minimum":1,"maximum":2},
    "domain_id":{"enum":["finance","supply_chain","software_engineering"]},
    "cohort_role":{"const":"FROZEN_PROTOCOL_REPLICATION"},
    "subject_condition":{"const":"NATURAL_UNMANIPULATED"},
    "code_commit_sha":{"type":"string","minLength":1},
    "plan_path":{"type":"string","minLength":1},
    "plan_hash":{"type":"string","minLength":1},
    "domain_hash":{"type":"string","minLength":1},
    "task_hash":{"type":"string","minLength":1},
    "agent_pool_hash":{"type":"string","minLength":1},
    "arena_config_path":{"type":"string","minLength":1},
    "arena_config_hash":{"type":"string","minLength":1},
    "model_config_path":{"type":"string","minLength":1},
    "model_config_hash":{"type":"string","minLength":1},
    "theory_contract_path":{"type":"string","minLength":1},
    "theory_contract_hash":{"type":"string","minLength":1},
    "measurement_contract_path":{"type":"string","minLength":1},
    "measurement_contract_hash":{"type":"string","minLength":1},
    "scout_config_path":{"type":"string","minLength":1},
    "scout_config_hash":{"type":"string","minLength":1},
    "experiment_profile_path":{"type":"string","minLength":1},
    "experiment_profile_hash":{"type":"string","minLength":1},
    "automatic_paid_evaluator":{"const":false},
    "semantic_review":{"const":"DEFERRED_APPEND_ONLY"},
    "no_outcome_aware_rerun":{"const":true},
    "scientific_status":{"const":"V5_CROSS_DOMAIN_HELD_OUT_SUBJECT_CANDIDATE_AWAITING_EXPLICIT_PAID_AUTHORIZATION"}
  }
}
